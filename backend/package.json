{
  "name": "@auditor-formulas/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": "18.14.x"
  },
  "scripts": {
    "dev": "node scripts/dev-with-heap.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --max-old-space-size=4096 dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "node --max-old-space-size=4096 ../node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "cors": "2.8.5",
    "exceljs": "4.4.0",
    "express": "4.18.2",
    "mongodb": "^5.9.2",
    "multer": "1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/multer": "1.4.11",
    "@types/node": "18.11.18",
    "@types/supertest": "2.0.16",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "8.10.0",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node-dev": "2.0.0",
    "typescript": "4.9.5"
  }
}
